Dockerfile
.dockerignore

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test files
test/
tests/
*.test.js
*.spec.js

# Plan files
.cursor/
plans/

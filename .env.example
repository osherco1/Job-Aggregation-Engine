# LinkedIn Voyager session (rotate from a freshly authenticated browser session;
# JSESSIONID and CSRF_TOKEN must match exactly).
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
LINKEDIN_CSRF_TOKEN=
LINKEDIN_ACCEPT_LANGUAGE=en-US,en;q=0.9
LINKEDIN_USER_AGENT=

# Storage
STORAGE_BACKEND=mongo
MONGODB_URI=

# Telegram notifications
# Bot token is shared between user job-reports and admin control-plane alerts.
TELEGRAM_BOT_TOKEN=
# User-facing chat (job report cards, Apply buttons).
TELEGRAM_CHAT_ID=
# Operator/control-plane chat (critical alerts + calibration reports).
# Required by services/notifications/TelegramAdminNotifier.js. May be the same
# as TELEGRAM_CHAT_ID for single-chat setups, or a separate group/private chat.
ADMIN_CHAT_ID=

# Legacy SMTP — still used by scraper.js (sendJobReport) and tools/discovery/run_discovery.js
# (sendCalibrationAlert). Safe to leave blank if those code paths are unused.
JOBBOT_SMTP_USER=
JOBBOT_SMTP_PASS=
JOBBOT_TO_EMAIL=

# GCS distributed lock + exactly-once quota alert flag
GCS_LOCK_BUCKET=
GCS_QUOTA_ALERT_FLAG_PATH=flags/quota-alert-sent.flag

# Feature flags (defaults shown)
DRY_RUN=false
SKIP_LINKEDIN=false
SKIP_ATS=false
RESET_DEDUP=false

# LinkedIn Credentials
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password

# Gmail SMTP Configuration
# Use App Password if 2FA is enabled
# For Phase 4, use JOBBOT_SMTP_* variables as configured in app/config.py
JOBBOT_SMTP_HOST=smtp.gmail.com
JOBBOT_SMTP_PORT=587
JOBBOT_SMTP_USER=your_gmail@gmail.com
JOBBOT_SMTP_PASS=your_app_password
JOBBOT_TO_EMAIL=your_email@example.com

# Database
# Default to SQLite for local development
DATABASE_URL=sqlite:///jobs.db

# Example for Render/Postgres (do NOT use locally unless you know what you're doing):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Job Search Configuration
JOBBOT_LOCATION=Israel
JOBBOT_TIME_FILTER="Past 24 hours"
